{
  "name": "gazesync",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Dependency-free zoom interaction and capture-time 2D/3D gaze synchronization",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    },
    "./simulation": {
      "types": "./src/simulation.d.ts",
      "import": "./src/simulation.js"
    }
  },
  "files": [
    "src/browser.d.ts",
    "src/browser.js",
    "src/clocks.js",
    "src/controller.js",
    "src/geometry.js",
    "src/index.d.ts",
    "src/index.js",
    "src/records.js",
    "src/session.js",
    "src/simulation.d.ts",
    "src/simulation.js",
    "src/version.js",
    "demo/index.html",
    "demo/app.js",
    "demo/style.css",
    "examples/canvas-integration.js",
    "tools/serve.mjs",
    "tools/server.mjs",
    "tools/files.mjs",
    "tools/simulate.mjs",
    "tools/replay.mjs",
    "public-files.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "simulate": "node tools/simulate.mjs",
    "replay": "node tools/replay.mjs",
    "start": "node tools/serve.mjs",
    "test:types": "tsc -p tsconfig.types.json",
    "release:check": "node tools/release-check.mjs",
    "export": "node tools/export.mjs",
    "bench": "node tools/bench.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
